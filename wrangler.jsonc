{
  // Cloudflare Workers (static assets) и Cloudflare Pages берут сайт из ./public, сборки нет.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudefire",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
